# Copy this file to .env and fill in your key.
# Get a Steam Web API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_web_api_key_here

# Optional
PORT=3000

# Optional — set this to view /api/stats (usage dashboard). Pick your own
# long random string; without it, /api/stats returns 404 for everyone,
# including you.
ADMIN_KEY=
